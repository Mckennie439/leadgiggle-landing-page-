# Supabase project credentials (used by src/lib/supabase.ts for blog/portfolio
# data and by src/lib/imageHelper.ts for storage-hosted image URLs).
# Find these in your Supabase project settings under Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to "true" to resolve local image paths through Supabase Storage even
# in development. Defaults to using paths as-is in dev when unset.
VITE_USE_SUPABASE_IMAGES=false
